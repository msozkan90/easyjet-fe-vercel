# Public values are embedded in the browser bundle. Never put private secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Optional browser-only Maps key: restrict website referrers, APIs and quotas.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional browser monitoring. Reports contain only category/status and trace IDs.
# Enable after the backend FRONTEND_TELEMETRY_ENABLED flag is configured.
NEXT_PUBLIC_TELEMETRY_ENABLED=false
NEXT_PUBLIC_TRACE_SAMPLE_RATIO=0.1
